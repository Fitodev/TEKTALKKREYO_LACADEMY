# Server-only Auth configuration. Keep all real values in .env.local (ignored)
# or in Vercel's secure environment settings. Never use service_role here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000

# Existing installations using NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY
# remain supported. No actual key belongs in this template.
